rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tutto è privato per utente. Offerte e confronti li scrive solo il backend (Admin SDK).
    match /users/{uid}/products/{id} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/stores/{id} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/flyers/{id} {
      allow read, create, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
    }
    match /users/{uid}/offers/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/matches/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
  }
}
