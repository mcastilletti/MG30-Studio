rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tutto è privato per utente. Offerte e confronti li scrive solo il backend (Admin SDK).
    match /users/{uid}/products/{id} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/stores/{id} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/flyers/{id} {
      allow read, create, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
    }
    match /users/{uid}/offers/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      // correzioni e prodotti aggiunti a mano
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.price is number && request.resource.data.price > 0;
    }
    match /users/{uid}/matches/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
  }
}
